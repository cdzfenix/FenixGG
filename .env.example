# Copia este archivo como .env.local y rellena tus valores
# NUNCA subas .env.local a GitHub

# Supabase - lo encuentras en: Project Settings > API
VITE_SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Twitch / IGDB - https://dev.twitch.tv/console/apps
# IMPORTANTE: estas variables NO llevan el prefijo VITE_ 
# porque solo las usa la Serverless Function del servidor (api/igdb.js)
# y NO deben exponerse al navegador.
TWITCH_CLIENT_ID=tu_client_id_de_twitch
TWITCH_CLIENT_SECRET=tu_client_secret_de_twitch

# Contraseña de administrador - cámbiala por algo seguro
VITE_ADMIN_PASSWORD=mi_contraseña_secreta
